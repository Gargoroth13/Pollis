# Copie este arquivo pra .env e preencha os valores em desenvolvimento local.
# Em produção (Railway/Render), essas mesmas variáveis são definidas no
# painel do host — nunca commite o .env de verdade.

# Gere uma chave nova com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-gerada

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Deixe em branco em desenvolvimento local (usa sqlite automaticamente).
# Em produção, cole a connection string do Postgres, algo como:
# postgres://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# Tempo do jogo (ver README, "Tempo do mundo")
# POLIS_GAME_TIMEZONE=America/Sao_Paulo
# Segundos reais por dia de jogo: 86400 = tempo real (produção); 600 = Bot Test
# POLIS_REAL_SECONDS_PER_GAME_DAY=86400
